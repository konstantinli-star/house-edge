# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.
# Never commit real values.

# Supabase (guest sessions use anonymous sign-in; enable it in Supabase → Auth → Providers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Stripe — TEST MODE keys only (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
